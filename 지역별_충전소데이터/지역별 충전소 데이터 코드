import requests
import pandas as pd
import math
import time

# ============================================================
# 1. API 설정
# ============================================================

SERVICE_KEY = "7037c6504734f246f59bd8744555a37323af9a912093bb5e08f14ff007f5cd72"

BASE_URL = (
    "http://apis.data.go.kr/"
    "B552584/EvCharger/getChargerInfo"
)

# API에서 한 번에 가져올 최대 건수
NUM_OF_ROWS = 9999

# 저장할 CSV 파일명
OUTPUT_FILE = "ev_charger_all.csv"


# ============================================================
# 2. API 호출 함수
# ============================================================

def get_page(page_no):

    params = {
        "serviceKey": SERVICE_KEY,
        "pageNo": page_no,
        "numOfRows": NUM_OF_ROWS,
        "dataType": "JSON"
    }

    response = requests.get(
        BASE_URL,
        params=params,
        timeout=60
    )

    response.raise_for_status()

    data = response.json()

    # --------------------------------------------------------
    # 실제 API 응답 구조
    #
    # {
    #     "items": {
    #         "item": [
    #             {...},
    #             {...}
    #         ]
    #     },
    #     "totalCount": ...
    # }
    # --------------------------------------------------------

    if "items" not in data:
        print("예상하지 못한 API 응답입니다.")
        print(data)
        raise Exception("API 응답에 items가 없습니다.")

    items = data.get("items", {})

    # item이 없는 경우
    if not items:
        return [], data.get("totalCount", 0)

    # item 추출
    records = items.get("item", [])

    # 데이터가 1개일 경우에도 리스트로 변환
    if isinstance(records, dict):
        records = [records]

    total_count = data.get("totalCount", 0)

    return records, total_count


# ============================================================
# 3. 첫 번째 페이지 호출
# ============================================================

print("첫 번째 페이지를 호출합니다...")

first_data, total_count = get_page(1)

total_count = int(total_count)

print()
print("=" * 60)
print(f"전체 데이터: {total_count:,}건")
print(f"첫 페이지: {len(first_data):,}건")
print("=" * 60)


# ============================================================
# 4. 전체 페이지 계산
# ============================================================

total_pages = math.ceil(
    total_count / NUM_OF_ROWS
)

print(f"총 페이지 수: {total_pages:,}페이지")


# ============================================================
# 5. 전체 데이터 저장
# ============================================================

all_data = []

# 첫 번째 페이지 저장
all_data.extend(first_data)

print(
    f"[1/{total_pages}] "
    f"{len(first_data):,}건 수집 "
    f"(누적 {len(all_data):,}건)"
)


# ============================================================
# 6. 나머지 페이지 반복 호출
# ============================================================

for page in range(2, total_pages + 1):

    try:

        records, _ = get_page(page)

        all_data.extend(records)

        print(
            f"[{page}/{total_pages}] "
            f"{len(records):,}건 수집 "
            f"(누적 {len(all_data):,}건)"
        )

        # 서버에 너무 빠르게 요청하지 않도록 대기
        time.sleep(0.2)

    except Exception as e:

        print()
        print(f"❌ {page}페이지 오류")
        print(e)

        # 오류 발생 시 잠시 기다렸다가 계속 진행
        time.sleep(2)


# ============================================================
# 7. 수집 결과 확인
# ============================================================

print()
print("=" * 60)
print("수집 완료")
print("=" * 60)

print(f"API 전체 데이터 : {total_count:,}건")
print(f"실제 수집 데이터: {len(all_data):,}건")


# ============================================================
# 8. DataFrame 생성
# ============================================================

df = pd.DataFrame(all_data)

print()
print(f"행(row): {len(df):,}")
print(f"열(column): {len(df.columns)}")

print()
print("컬럼 목록:")
print(df.columns.tolist())


# ============================================================
# 9. CSV 저장
# ============================================================

df.to_csv(
    OUTPUT_FILE,
    index=False,
    encoding="utf-8-sig"
)

print()
print("=" * 60)
print(f"CSV 저장 완료!")
print(f"파일명: {OUTPUT_FILE}")
print("=" * 60)

